# Copy to .env.local and fill in real values. Never commit .env.local.
# See CLAUDE.md and openspec/changes/define-stack/ for the reasoning
# behind every constraint noted below.

# ---------------------------------------------------------------------
# Supabase (Auth + Postgres)
# ---------------------------------------------------------------------
# Client-side (Next.js requires the NEXT_PUBLIC_ prefix to expose these
# to the browser bundle). Only the URL and anon key are ever public.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Public URL of the app (auth redirects and callback). Required.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# No SUPABASE_SERVICE_ROLE_KEY is defined: the app connects exclusively
# via the user-scoped anon client and Postgres RLS is the sole
# authorization authority (CLAUDE.md, C1). CI fails the build if
# `service_role` or `SUPABASE_SERVICE_ROLE_KEY` appears under src/.

# ---------------------------------------------------------------------
# Cloudinary (gallery photos — supersedes the original Supabase Storage
# plan, see openspec/changes/define-stack/design.md §7)
# ---------------------------------------------------------------------
# Cloud name is not secret and may be exposed to the client if a
# Cloudinary client SDK needs it directly, but uploads/deliveries in
# this app always go through a server-signed request — see CLAUDE.md
# "Media (gallery photos)".
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name

# Server-only. Used to generate signed upload params and signed delivery
# URLs. NEVER prefix with NEXT_PUBLIC_, never ship to the client.
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# ---------------------------------------------------------------------
# Google OAuth (US-01 — Supabase Auth social login)
# ---------------------------------------------------------------------
# Configured on the Supabase Auth provider settings, not read directly
# by the app at runtime -- kept here as a reminder of the dependency
# (proposal.md "Dependencies"). Remove this block if the app never
# reads these directly.
GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id
GOOGLE_OAUTH_CLIENT_SECRET=your-google-oauth-client-secret

# ---------------------------------------------------------------------
# Health check / keep-alive (design.md §9 — prevents Supabase's 7-day
# auto-pause on the free tier from reading as an outage)
# ---------------------------------------------------------------------
# Optional shared secret if /api/health should require `Authorization: Bearer <secret>`.
# Vercel Cron automatically sends `CRON_SECRET` in that header when set in the project.
# Leave both empty for an unauthenticated, no-data health endpoint.
HEALTH_CHECK_SECRET=
CRON_SECRET=

# ---------------------------------------------------------------------
# Observability (RNF-13)
# ---------------------------------------------------------------------
# Optional. Without a DSN Sentry stays off and errors are only written as
# structured JSON logs (src/instrumentation.ts). Use the same DSN for both;
# the public one is loaded lazily in the browser.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Vercel Analytics and Speed Insights need no variables: enable them in the
# Vercel project (Analytics / Speed Insights tabs).
